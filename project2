#!/usr/bin/env escript
%%! +S 4:4
-mode(compile).
main(Args) ->
    Dir = filename:dirname(escript:script_name()),
    case compile:file(filename:join([Dir,"src","gossip_sim.erl"]), [binary,report_errors,report_warnings]) of
        {ok, gossip_sim, Bin} -> code:load_binary(gossip_sim, "gossip_sim.erl", Bin), gossip_sim:main(Args);
        _ -> halt(1)
    end.
